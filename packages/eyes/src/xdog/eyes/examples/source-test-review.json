{
  "version": 1,
  "name": "review-source-changes",
  "sources": [{"id": "files", "type": "file", "root": ".", "include": ["src/**"], "exclude": ["**/__pycache__/**"]}],
  "detectors": [{"id": "changes", "type": "file.change", "source": "files", "debounce_ms": 500, "max_batch_delay_ms": 2000}],
  "handlers": [{"id": "review", "type": "session.notify", "target": "current", "instruction": "Review changed source and determine whether related tests need updates. Follow current tool permissions."}],
  "routes": [{"id": "review-route", "detector": "changes", "handler": "review", "event_types": ["file.created", "file.modified", "file.deleted"]}]
}
