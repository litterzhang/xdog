class WorkflowError(Exception):
    """Base class for all flow workflow errors."""


class WorkflowExecutionError(WorkflowError):
    """Raised when a workflow fails during execution."""


class WorkflowBudgetExceeded(WorkflowError):
    """Raised when a run's cumulative token usage exceeds its configured budget."""

    def __init__(self, used: int, budget: int) -> None:
        super().__init__(f"token budget exceeded: used {used} > budget {budget}")
        self.used = used
        self.budget = budget


class WorkflowPaused(Exception):
    """Raised when a human node pauses the run awaiting an external signal."""

    def __init__(self, node_id: str, signal: str) -> None:
        super().__init__(f"paused at {node_id!r} awaiting signal {signal!r}")
        self.node_id = node_id
        self.signal = signal


class RuntimeContext:
    """Read-only runtime info for a single script-node invocation.

    A plain class (not a dataclass) so it works when this module is exec'd into
    an unregistered module object — @dataclass resolves string annotations via
    sys.modules[cls.__module__], which fails there.
    """

    __slots__ = ("step", "node_id", "workflow_name", "workspace", "allow_paths", "confined")

    def __init__(
        self,
        step: int,
        node_id: str,
        workflow_name: str,
        workspace: "Path | None" = None,
        allow_paths: "tuple[Path, ...]" = (),
        confined: bool = False,
    ) -> None:
        self.step = step
        self.node_id = node_id
        self.workflow_name = workflow_name
        # A script held to a workspace has to be able to find out where it is;
        # being refused for writing outside a directory you were never told about
        # is a trap, not a rule. Nodes run concurrently, so the executor cannot
        # chdir there on a script's behalf without corrupting its siblings.
        self.workspace = workspace
        self.allow_paths = allow_paths
        self.confined = confined



