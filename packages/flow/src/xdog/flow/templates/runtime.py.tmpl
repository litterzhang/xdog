class UnauditableCall(PermissionError):
    """A confined script reached for something the audit hook cannot follow."""


_SCRIPT_BOUND: "contextvars.ContextVar[Any]" = contextvars.ContextVar("xdog_script_bound", default=None)
_HOOK_INSTALLED = [False]


def _import_roots() -> "tuple[Path, ...]":
    """Trees a script must be able to read, or it cannot import anything."""
    candidates = [sys.prefix, sys.base_prefix, sysconfig.get_path("stdlib") or ""]
    try:
        candidates.extend(site.getsitepackages())
        candidates.append(site.getusersitepackages())
    except Exception:
        pass
    # Deliberately NOT all of sys.path: a bundle run as `python <dir>` has its
    # own directory at sys.path[0], and reading that granted this engine a root
    # the interpreter never had. Workflow-local code is granted via _code_roots().
    roots = []
    for c in candidates:
        try:
            roots.append(Path(c).resolve())
        except (OSError, ValueError):
            pass
    return tuple(dict.fromkeys(roots))


def _code_roots() -> "tuple[Path, ...]":
    """This module's own directory: where a `run:` script and its siblings live."""
    here = globals().get("__file__")
    return (Path(here).resolve().parent,) if here else ()


def _is_code(path: object, code_roots: "Sequence[Path]") -> bool:
    if not code_roots or not isinstance(path, str):
        return False
    return Path(path).suffix in _CODE_SUFFIXES and _within(path, code_roots)


def _within(path: object, roots: "Sequence[Path]") -> bool:
    if not isinstance(path, (str, bytes)):
        return True
    text = path.decode("utf-8", "replace") if isinstance(path, bytes) else path
    if not text:
        return True
    try:
        resolved = Path(text).resolve()
    except (OSError, ValueError):
        return False
    return any(resolved == r or r in resolved.parents for r in roots)


def _script_hook(event: str, args: "tuple[Any, ...]") -> None:
    bound = _SCRIPT_BOUND.get()
    if bound is None:
        return
    write_roots, read_roots, code_roots, confined = bound
    if event in _UNAUDITABLE:
        if confined:
            raise UnauditableCall(
                f"{event} cannot be audited, and this run is confined. "
                f"Remove it, or run without FLOW_CONFINED."
            )
        return
    if event == "open":
        path = args[0] if args else None
        mode = args[1] if len(args) > 1 else ""
        writing = isinstance(mode, str) and any(c in mode for c in "wxa+")
        if not writing and not _within(path, read_roots) and _is_code(path, code_roots):
            return  # importing a sibling module, which resolution already trusts
        if not _within(path, write_roots if writing else read_roots):
            allowed = ", ".join(str(r) for r in write_roots) or "<nothing>"
            verb = "write" if writing else "read"
            raise PermissionError(
                f"Cannot {verb} {path}: outside this run's workspace. Allowed: {allowed}"
            )
        return
    indices = _WRITE_EVENTS.get(event)
    if indices is None:
        return
    for i in indices:
        if i < len(args) and not _within(args[i], write_roots):
            allowed = ", ".join(str(r) for r in write_roots) or "<nothing>"
            raise PermissionError(
                f"Cannot {event} {args[i]}: outside this run's workspace. Allowed: {allowed}"
            )


@contextlib.contextmanager
def script_bound(
    workspace: "Path | None", allow_paths: "Sequence[Path]" = (), *, confined: bool = False
) -> "Iterator[None]":
    """Hold the code inside this block to *workspace* plus *allow_paths*."""
    if workspace is None:
        yield
        return
    workspace.mkdir(parents=True, exist_ok=True)
    if not _HOOK_INSTALLED[0]:
        sys.addaudithook(_script_hook)
        _HOOK_INSTALLED[0] = True
    write_roots = tuple(dict.fromkeys([workspace.resolve(), *(p.resolve() for p in allow_paths)]))
    token = _SCRIPT_BOUND.set(
        (write_roots, write_roots + _import_roots(), _code_roots(), confined)
    )
    try:
        yield
    finally:
        _SCRIPT_BOUND.reset(token)


_COERCE_TRUE = {"true", "1", "yes", "on"}
_COERCE_FALSE = {"false", "0", "no", "off", ""}


def port_str(value: object) -> str:
    """Project a stored port *value* to its canonical string form (verbatim str or sorted JSON)."""
    if isinstance(value, str):
        return value
    return json.dumps(value, ensure_ascii=False, sort_keys=True)


def _to_bool(value: object) -> bool:
    if isinstance(value, bool):
        return value
    low = str(value).strip().lower()
    if low in _COERCE_TRUE:
        return True
    if low in _COERCE_FALSE:
        return False
    raise ValueError(f"cannot coerce {value!r} to boolean")


_JSONPATH_CACHE: dict[str, Any] = {}


def jsonpath_get(state: object, path: str) -> object:
    """Return the first JSONPath *path* match in *state*, or None if none."""
    expr = _JSONPATH_CACHE.get(path)
    if expr is None:
        expr = _jsonpath_parse(path)
        _JSONPATH_CACHE[path] = expr
    matches = expr.find(state)
    return matches[0].value if matches else None


def _fan_concat(value: object) -> object:
    """fan_in="concat": flatten a list-of-arrays one level (mirrors _build_inputs)."""
    if not isinstance(value, (list, tuple)):
        return value
    _flat: list[object] = []
    for _item in value:
        if isinstance(_item, (list, tuple)):
            _flat.extend(_item)
        else:
            _flat.append(_item)
    return _flat


def interp_path(state: dict[str, object], path: str) -> str:
    """Resolve a JSONPath ``{{path}}`` against *state* and project to text ('' on miss)."""
    resolved = jsonpath_get(state, path)
    if resolved is None:
        return ""
    return port_str(resolved)


def _ncmp(a: str, b: str, op: str) -> bool:
    """Numeric compare of two interpolated operands (mirrors flow.conditions).

    An empty operand (an unresolved value, e.g. a loop-carried port on the first
    pass) makes the comparison False — lenient, like interpolation.  A non-empty
    non-numeric operand raises, since that is a real authoring error.
    """
    if a.strip() == "" or b.strip() == "":
        return False
    _l, _r = float(a), float(b)
    if op == "gt":
        return _l > _r
    if op == "gte":
        return _l >= _r
    if op == "lt":
        return _l < _r
    return _l <= _r


def to_python(value: object, json_type: str) -> Any:
    """Coerce a stored wire *value* into the Python type named by *json_type* (tolerant)."""
    if json_type == "string":
        return value if isinstance(value, str) else port_str(value)
    if json_type == "integer":
        if isinstance(value, bool):
            return int(value)
        if isinstance(value, int):
            return value
        if isinstance(value, float):
            return int(value)
        s = str(value).strip()
        return int(s) if s != "" else 0
    if json_type == "number":
        if isinstance(value, bool):
            return float(value)
        if isinstance(value, (int, float)):
            return float(value)
        s = str(value).strip()
        return float(s) if s != "" else 0.0
    if json_type == "boolean":
        return _to_bool(value)
    if json_type in ("array", "object"):
        if isinstance(value, str):
            if value.strip() == "":
                return [] if json_type == "array" else {}
            value = json.loads(value)
        if isinstance(value, tuple):
            value = list(value)
        if json_type == "array" and not isinstance(value, list):
            raise ValueError(f"expected a JSON array, got {type(value).__name__}")
        if json_type == "object" and not isinstance(value, dict):
            raise ValueError(f"expected a JSON object, got {type(value).__name__}")
        return value
    raise ValueError(f"unknown json type {json_type!r}")


def to_state(value: object, json_type: str) -> object:
    """Coerce a script's return *value* into the stored wire value (type-native)."""
    if json_type == "string":
        return value if isinstance(value, str) else port_str(value)
    if json_type == "integer":
        if isinstance(value, bool):
            return int(value)
        if isinstance(value, int):
            return value
        if isinstance(value, float):
            return int(value)
        return int(str(value).strip() or "0")
    if json_type == "number":
        if isinstance(value, bool):
            return float(value)
        if isinstance(value, (int, float)):
            return float(value)
        return float(str(value).strip() or "0")
    if json_type == "boolean":
        return _to_bool(value)
    if json_type in ("array", "object"):
        if isinstance(value, str):
            value = json.loads(value) if value.strip() != "" else ([] if json_type == "array" else {})
        if isinstance(value, tuple):
            value = list(value)
        if json_type == "array" and not isinstance(value, list):
            raise ValueError(f"expected a JSON array, got {type(value).__name__}")
        if json_type == "object" and not isinstance(value, dict):
            raise ValueError(f"expected a JSON object, got {type(value).__name__}")
        return value
    raise ValueError(f"unknown json type {json_type!r}")


