# ---------------------------------------------------------------------------
# Checkpoint helpers — active only when FLOW_RUN_ID + FLOW_CHECKPOINT_DIR set.
# ---------------------------------------------------------------------------
_FLOW_RUN_ID: str | None = None
_FLOW_CHECKPOINT_DIR: str | None = None
_CHECKPOINT_LOADED = False


def _skill_repo() -> "Any":
    """The same repo the interpreter builds: this module's own `skills/`
    directory (copied from beside the workflow) plus installed packages."""
    from xdog.agent.skills import SkillRepo

    dirs = _skill_dirs()
    repo = SkillRepo()
    if dirs:
        repo.register(directory=dirs[0], name="shared")
    return repo


def _skill_dirs() -> "list[Path]":
    """`skills/` beside this module — the bundle's copy of what sat beside the
    workflow file.

    The same lookup the interpreter does, so a workflow carrying its own skill
    renders the same system prompt through either engine. Left out, an installed
    bundle would quietly send a shorter prompt than the same workflow run from
    its directory, and the difference would show up as worse output rather than
    as an error.
    """
    here = globals().get("__file__")
    return [Path(here).resolve().parent / "skills"] if here else []


def _workspace_dir() -> "Path | None":
    """This run's workspace — where a relative path resolves.

    Every run has one, exactly as in the interpreter. It defaults to `runtime/`
    beside this module rather than the process's cwd, so a scheduled run and a
    hand-run land in the same place. It is not created here; writing to it makes
    it, so a run that writes nothing leaves nothing behind.
    """
    override = os.environ.get("FLOW_WORKSPACE")
    if override:
        return Path(override)
    # `globals()` rather than `__file__` directly: the parity tests exec this
    # source with no file behind it, and a module that only works when it has a
    # path on disk would pass its own tests and fail nowhere useful.
    #
    # No file means no workspace — not `Path.cwd()/runtime`. Inventing one from
    # the process's ambient state and then creating it is how a test run left a
    # `runtime/` directory in the repository root.
    here = globals().get("__file__")
    return Path(here).resolve().parent / "runtime" if here else None


def _granted_paths() -> tuple[Path, ...]:
    """Extra trees granted by FLOW_ALLOW_PATHS, as the script node sees them."""
    granted = os.environ.get("FLOW_ALLOW_PATHS", "")
    return tuple(Path(part).resolve() for part in granted.split(os.pathsep) if part)


def _confinement_roots() -> list[str] | None:
    """Directories this run may touch, or None when it is unconfined.

    Mirrors the interpreter's `execute(confined=..., allow_paths=...)`. The
    grant comes from the environment because it is a property of *this run*, not
    of the workflow: a module that could read its own allowance out of its own
    source would not be confined by it.

        FLOW_CONFINED=1 FLOW_ALLOW_PATHS=/data python workflow.py

    Having a workspace and being confined to it are separate: unset means the
    workspace is a convention and nothing is refused, which is the default.
    """
    if os.environ.get("FLOW_CONFINED", "") not in ("1", "true", "yes"):
        return None
    ws = _workspace_dir()
    roots = [str(ws.resolve())] if ws is not None else []
    return roots + [str(p) for p in _granted_paths()]


def _checkpoint_path() -> Path | None:
    if _FLOW_RUN_ID and _FLOW_CHECKPOINT_DIR:
        return Path(_FLOW_CHECKPOINT_DIR) / f"{_FLOW_RUN_ID}.json"
    return None


def _load_checkpoint() -> None:
    global _CHECKPOINT_LOADED
    p = _checkpoint_path()
    if p is None or not p.exists():
        return
    with p.open(encoding="utf-8") as _fh:
        _snap: dict[str, object] = json.load(_fh)
    expected = {"outputs", "completed", "loop_counters", "stack", "out_live", "memo", "tokens_used"}
    # `sessions` is optional so a checkpoint written before `inherit` existed
    # still resumes, carrying no sessions — the same state a run has before any
    # agent node has spoken.
    if set(_snap) - {"sessions"} != expected:
        raise WorkflowExecutionError("checkpoint does not match the current schema")
    _out, _done = _snap["outputs"], _snap["completed"]
    _lc, _stk = _snap["loop_counters"], _snap["stack"]
    _outp, _mem, _tok = _snap["out_live"], _snap["memo"], _snap["tokens_used"]
    _sess = _snap.get("sessions") or {}
    if isinstance(_sess, dict):
        _SESSIONS.update({str(k): dict(v) for k, v in _sess.items() if isinstance(v, dict)})
    if not isinstance(_out, dict) or not isinstance(_done, list):
        raise WorkflowExecutionError("checkpoint outputs/completed have invalid types")
    if not isinstance(_lc, dict) or not isinstance(_stk, list):
        raise WorkflowExecutionError("checkpoint loop_counters/stack have invalid types")
    if not isinstance(_outp, dict) or not isinstance(_mem, dict) or not isinstance(_tok, int):
        raise WorkflowExecutionError("checkpoint out_live/memo/tokens_used have invalid types")
    _CHECKPOINT_LOADED = True
    _OUT.clear()
    _OUT.update(_out)  # type: ignore[arg-type]
    _COMPLETED.update(str(node_id) for node_id in _done)
    _STACK.extend(frame for frame in _stk if isinstance(frame, dict))  # type: ignore[arg-type]
    _OUTPUT.update(_outp)  # type: ignore[arg-type]
    for _mk, _mv in _mem.items():
        if isinstance(_mv, dict):
            _MEMO[str(_mk)] = dict(_mv)  # type: ignore[arg-type]
    global _TOKENS_USED
    _TOKENS_USED = _tok
    for _lk, _lv in _lc.items():
        if isinstance(_lv, int):
            _LOOP_COUNTERS[str(_lk)] = _lv


def _checkpoint_snapshot() -> dict[str, object]:
    return {
        "outputs": _OUT,
        "sessions": _SESSIONS,
        "completed": list(_COMPLETED),
        "stack": _STACK,
        "out_live": _OUTPUT,
        "memo": _MEMO,
        "tokens_used": _TOKENS_USED,
        "loop_counters": _LOOP_COUNTERS,
    }


def _persist_checkpoint(snapshot: dict[str, object]) -> None:
    p = _checkpoint_path()
    if p is None:
        return
    p.parent.mkdir(parents=True, exist_ok=True)
    _fd, _tmp = tempfile.mkstemp(dir=p.parent, suffix=".tmp")
    try:
        with os.fdopen(_fd, "w", encoding="utf-8") as _fh:
            json.dump(snapshot, _fh, ensure_ascii=False)
        os.replace(_tmp, p)
    except Exception:
        try:
            os.unlink(_tmp)
        except OSError:
            pass
        raise


_CHECKPOINT = CheckpointInterceptor(_checkpoint_snapshot, _persist_checkpoint)


